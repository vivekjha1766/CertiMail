# CertiMail Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173

# SQLite Database Location
DATABASE_URL=sqlite:///data/certimailer.db

# SMTP Configuration (Optional default values; can also be configured via Web UI Settings)
# For Gmail, generate an App Password from your Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_SENDER_NAME="CertiMail Admin"
SMTP_SENDER_EMAIL=your-event-email@gmail.com
SMTP_USERNAME=your-event-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# Optional Global CC and BCC defaults (comma-separated)
GLOBAL_CC=
GLOBAL_BCC=
